<Window x:Class="AdaptiveBarPC.Designer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AdaptiveBarPC.Designer"
        xmlns:models="clr-namespace:AdaptiveBarPC.Models;assembly=AdaptiveBarPC"
        xmlns:controls="clr-namespace:AdaptiveBarPC.Controls;assembly=AdaptiveBarPC"
        Title="{Binding WindowTitle}"
        Icon="/AdaptiveBarPC;component/Resources/Brand/AdaptiveBar.ico"
        Width="1600"
        Height="1000"
        MinWidth="960"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource EditorBackground}"
        FontFamily="Segoe UI"
        PreviewKeyDown="Designer_OnPreviewKeyDown"
        PreviewKeyUp="Designer_OnPreviewKeyUp"
        SizeChanged="Studio_OnSizeChanged"
        PreviewMouseLeftButtonDown="HistoryPointer_OnDown"
        PreviewMouseLeftButtonUp="HistoryPointer_OnUp"
        PreviewTouchDown="HistoryPointer_OnDown"
        PreviewTouchUp="HistoryPointer_OnUp">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <local:StudioItemConverter x:Key="StudioItem"/>
        <Style x:Key="StudioIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="StudioWidgetIcon">
            <Grid Width="24" Height="24">
                <TextBlock x:Name="Glyph" Text="{Binding ., Converter={StaticResource StudioItem}, ConverterParameter=Icon}" Style="{StaticResource StudioIcon}"/>
                <Path x:Name="SpacerDots" Visibility="Collapsed" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 7,4 L 7,4.1 M 17,4 L 17,4.1 M 7,12 L 7,12.1 M 17,12 L 17,12.1 M 7,20 L 7,20.1 M 17,20 L 17,20.1"/>
            </Grid>
            <DataTemplate.Triggers><DataTrigger Binding="{Binding Type}" Value="spacer"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/><Setter TargetName="SpacerDots" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="StudioIconButton" TargetType="Button" BasedOn="{StaticResource EditorButtonStyle}">
            <Setter Property="Width" Value="34"/><Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="StudioModeButton" TargetType="RadioButton">
            <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="ModeRoot" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeRoot" Property="Background" Value="{StaticResource EditorInput}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="ModeRoot" Property="Background" Value="{StaticResource EditorSelection}"/><Setter TargetName="ModeRoot" Property="BorderBrush" Value="{StaticResource EditorBorderFocus}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ModeRoot" Property="BorderBrush" Value="{StaticResource PrimaryText}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CanvasToolButton" TargetType="Button" BasedOn="{StaticResource StudioIconButton}">
            <Setter Property="Width" Value="40"/><Setter Property="MinHeight" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="InspectorSectionIcon" TargetType="TextBlock" BasedOn="{StaticResource StudioIcon}">
            <Setter Property="Foreground" Value="{StaticResource EditorAccentText}"/>
            <Setter Property="FontSize" Value="22"/><Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="WidthStepStyle" TargetType="RepeatButton">
            <Setter Property="Width" Value="28"/><Setter Property="Height" Value="21"/>
            <Setter Property="Delay" Value="400"/><Setter Property="Interval" Value="90"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
                <Border x:Name="StepRoot" Background="{StaticResource EditorPanelRaised}" CornerRadius="4" BorderBrush="{StaticResource EditorBorder}" BorderThickness="1">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StepRoot" Property="Background" Value="{StaticResource EditorSelection}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="StepRoot" Property="Background" Value="{StaticResource EditorPrimaryPressed}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="StepRoot" Property="BorderBrush" Value="{StaticResource EditorBorderFocus}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- ============================================================ -->
        <!--  Designer Placeholder DataTemplate (unsupported widgets only) -->
        <!--  Canonical runtime widgets resolve from BarControls.xaml      -->
        <!-- ============================================================ -->
        <DataTemplate DataType="{x:Type local:DesignerPlaceholderPreview}">
            <Border Width="{Binding Width}"
                    Height="56"
                    Margin="2,0"
                    Padding="10,0"
                    Background="{StaticResource ControlWell}"
                    CornerRadius="8">
                <TextBlock Text="{Binding Text}"
                           Foreground="{StaticResource SecondaryText}"
                           FontSize="10.5"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DesignerPreviewItemTemplate" DataType="{x:Type local:PreviewItemViewModel}">
            <Grid Background="Transparent"
                  PreviewMouseLeftButtonDown="PreviewItem_OnPreviewMouseLeftButtonDown"
                  PreviewMouseMove="PreviewItem_OnPreviewMouseMove"
                  PreviewMouseLeftButtonUp="PreviewItem_OnPreviewMouseLeftButtonUp">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.IsDecorativeMediaEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                    <Condition Binding="{Binding IsSelected}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Opacity" Value="0.35"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border BorderBrush="Transparent"
                        CornerRadius="9">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding DataContext.IsDecorativeMediaEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                        <Condition Binding="{Binding IsSelected}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ContentControl Content="{Binding Content}"/>
                </Border>
                <Thumb Width="12"
                       Height="42"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Cursor="SizeWE"
                       Background="Transparent"
                       DragStarted="ResizeThumb_OnDragStarted"
                       DragDelta="ResizeThumb_OnDragDelta"
                       DragCompleted="ResizeThumb_OnDragCompleted">
                    <Thumb.Style>
                        <Style TargetType="Thumb">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Background="Transparent">
                                            <Border Width="2"
                                                    Height="24"
                                                    CornerRadius="1"
                                                    Background="{StaticResource AccentBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected}" Value="True"/>
                                        <Condition Binding="{Binding CanResize}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Thumb.Style>
                </Thumb>
            </Grid>
        </DataTemplate>

        <!-- ============================================================ -->
        <!--  Designer Studio Workbench Styles                             -->
        <!-- ============================================================ -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="12,10,12,6"/>
        </Style>

        <Style x:Key="InspectorLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
        </Style>

        <Style x:Key="InspectorCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource EditorMaterial}"/>
            <Setter Property="BorderBrush" Value="{StaticResource EditorBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="DesignerTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{StaticResource EditorPanelRaised}"
                                    BorderBrush="{StaticResource EditorBorder}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,0,8,0">
                                <TabPanel IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" TextElement.FontWeight="Normal" TextElement.FontSize="14"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DesignerTabItemStyle" TargetType="TabItem">
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabRoot"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,6,-1">
                            <ContentPresenter x:Name="TabHeader" ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="#0AFFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabRoot" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                                <Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickColorChipStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="{StaticResource EditorBorder}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource PrimaryText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ -->
        <!--  ColorAreaControl Style (2D Saturation-Value Color Box)      -->
        <!-- ============================================================ -->
        <Style TargetType="{x:Type local:ColorAreaControl}">
            <Setter Property="Height" Value="125"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:ColorAreaControl}">
                        <Border CornerRadius="6" BorderBrush="{StaticResource EditorBorder}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <!-- Layer 1: Pure Hue Background -->
                                <Rectangle Fill="{TemplateBinding HueBrush}"/>

                                <!-- Layer 2: Horizontal White Gradient (Saturation: 0 at left to 1 at right) -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- Layer 3: Vertical Black Gradient (Value/Brightness: 1 at top to 0 at bottom) -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#FF000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- Layer 4: Canvas for Reticle Thumb -->
                                <Canvas x:Name="PART_Canvas" IsHitTestVisible="False">
                                    <Border x:Name="PART_Reticle"
                                            Width="14" Height="14"
                                            CornerRadius="7"
                                            BorderBrush="#FFFFFFFF"
                                            BorderThickness="2"
                                            Background="Transparent">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.85" Color="#000000"/>
                                        </Border.Effect>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ -->
        <!--  Hue Rainbow Slider Style                                    -->
        <!-- ============================================================ -->
        <Style x:Key="HueSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="360"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="15"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Rainbow Background Track -->
                            <Border Height="12" CornerRadius="6" BorderBrush="{StaticResource EditorBorder}" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFF0000" Offset="0.000"/>
                                        <GradientStop Color="#FFFFFF00" Offset="0.167"/>
                                        <GradientStop Color="#FF00FF00" Offset="0.333"/>
                                        <GradientStop Color="#FF00FFFF" Offset="0.500"/>
                                        <GradientStop Color="#FF0000FF" Offset="0.667"/>
                                        <GradientStop Color="#FFFF00FF" Offset="0.833"/>
                                        <GradientStop Color="#FFFF0000" Offset="1.000"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="14" Height="14" CornerRadius="7" Background="#FFFFFFFF" BorderBrush="#FF222228" BorderThickness="2">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.5" Color="#000000"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ -->
        <!--  Color Field Template (Stacked Label + Modern Visual Picker) -->
        <!-- ============================================================ -->
        <DataTemplate DataType="{x:Type local:ColorFieldViewModel}">
            <StackPanel Margin="0,0,0,4">
                <!-- Stacked Header: Title on line 1, Subtitle on line 2 (Always fully readable, no clipping) -->
                <StackPanel Margin="0,0,0,5" ToolTip="{Binding FullLabelTooltip}">
                    <TextBlock Text="{Binding Label}"
                               Foreground="{StaticResource PrimaryText}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SubLabelClean}"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="10"
                               Margin="0,1.5,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasSubLabel, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- Interactive Row: [ Swatch (28x28) ] [ HEX Input ] [ Auto/Reset ] -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Swatch Button -->
                    <Button AutomationProperties.Name="Open visual color picker (2D SV, Hue, RGB, Quick Palette)" x:Name="SwatchButton"
                            Grid.Column="0"
                            Width="28" Height="28"
                            HorizontalAlignment="Left"
                            Command="{Binding ToggleFlyoutCommand}"
                            Cursor="Hand"
                            ToolTip="Open visual color picker (2D SV, Hue, RGB, Quick Palette)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SwatchBorder"
                                        Background="{Binding Brush}"
                                        BorderBrush="{StaticResource EditorBorder}"
                                        BorderThickness="1.5"
                                        CornerRadius="4">
                                    <Border x:Name="HoverOverlay" Background="Transparent" CornerRadius="3"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SwatchBorder" Property="BorderBrush" Value="{StaticResource PrimaryText}"/>
                                        <Setter TargetName="HoverOverlay" Property="Background" Value="#25FFFFFF"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsFlyoutOpen}" Value="True">
                                        <Setter TargetName="SwatchBorder" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                        <Setter TargetName="SwatchBorder" Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Modern Visual Color Picker Popup Flyout (Placed to Left of Inspector so labels are NEVER obscured) -->
                    <Popup x:Name="ColorPopup"
                           IsOpen="{Binding IsFlyoutOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=SwatchButton}"
                           Placement="Left"
                           HorizontalOffset="-8"
                           VerticalOffset="-30"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="#FF16171E"
                                PreviewKeyDown="Designer_OnPreviewKeyDown"
                                PreviewMouseLeftButtonDown="HistoryPointer_OnDown"
                                PreviewMouseLeftButtonUp="HistoryPointer_OnUp"
                                PreviewTouchDown="HistoryPointer_OnDown"
                                PreviewTouchUp="HistoryPointer_OnUp"
                                BorderBrush="{StaticResource EditorBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Width="264">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.85" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel Width="240">
                                <!-- 1. 2D Saturation/Value Selection Box -->
                                <local:ColorAreaControl HueBrush="{Binding HueBrush}"
                                                        Saturation="{Binding Saturation, Mode=TwoWay}"
                                                        Brightness="{Binding Brightness, Mode=TwoWay}"
                                                        Height="125"/>

                                <!-- 2. Separate Rainbow Hue Slider -->
                                <Slider AutomationProperties.Name="Hue" Style="{StaticResource HueSliderStyle}"
                                        Value="{Binding Hue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,8,0,0"/>

                                <!-- 3. Preview Swatch + Editable HEX + Copy Button -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="24" Height="24"
                                            Background="{Binding Brush}"
                                            BorderBrush="{StaticResource EditorBorder}"
                                            BorderThickness="1.5"
                                            CornerRadius="4"
                                            VerticalAlignment="Center"/>
                                    <TextBox AutomationProperties.Name="{Binding Label, StringFormat={}{0} hex color}" Grid.Column="1"
                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EditorTextBoxStyle}"
                                             FontFamily="Consolas, Segoe UI"
                                             FontSize="11.5"
                                             VerticalContentAlignment="Center"
                                             Padding="6,2"
                                             Height="24"
                                             Margin="6,0,6,0"/>
                                    <Button AutomationProperties.Name="Copy HEX code to clipboard" Grid.Column="2"
                                            Content="📋"
                                            ToolTip="Copy HEX code to clipboard"
                                            Command="{Binding CopyHexCommand}"
                                            Style="{StaticResource EditorSecondaryButtonStyle}"
                                            Padding="6,2"
                                            Height="24"
                                            FontSize="11"/>
                                </Grid>

                                <!-- 4. RGB / sRGB Numeric Values -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- R -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="R" Foreground="#FFFF6B6B" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox AutomationProperties.Name="Red channel" Text="{Binding RText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextBoxStyle}"
                                                 FontFamily="Consolas, Segoe UI"
                                                 FontSize="11"
                                                 TextAlignment="Center"
                                                 Width="42" Height="22"
                                                 Padding="2,1"/>
                                    </StackPanel>

                                    <!-- G -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="G" Foreground="#FF51CF66" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox AutomationProperties.Name="Green channel" Text="{Binding GText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextBoxStyle}"
                                                 FontFamily="Consolas, Segoe UI"
                                                 FontSize="11"
                                                 TextAlignment="Center"
                                                 Width="42" Height="22"
                                                 Padding="2,1"/>
                                    </StackPanel>

                                    <!-- B -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="B" Foreground="#FF339AF0" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox AutomationProperties.Name="Blue channel" Text="{Binding BText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextBoxStyle}"
                                                 FontFamily="Consolas, Segoe UI"
                                                 FontSize="11"
                                                 TextAlignment="Center"
                                                 Width="42" Height="22"
                                                 Padding="2,1"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Background="{StaticResource EditorBorder}" Margin="0,10,0,8"/>

                                <!-- 5. Quick Colors Header + Reset Button -->
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="QUICK COLORS"
                                               Foreground="{StaticResource SecondaryText}"
                                               FontSize="9.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Button AutomationProperties.Name="{Binding ResetTooltip}" Grid.Column="1"
                                            Content="{Binding ResetLabel}"
                                            ToolTip="{Binding ResetTooltip}"
                                            Command="{Binding ResetCommand}"
                                            Style="{StaticResource EditorSecondaryButtonStyle}"
                                            Padding="6,1"
                                            Height="20"
                                            FontSize="10"/>
                                </Grid>

                                <!-- 6. 20 Quick Color Chips Grid (10 Neutrals + 10 Accents) -->
                                <ItemsControl ItemsSource="{Binding QuickColors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="10" Rows="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:QuickColorItem}">
                                            <Button AutomationProperties.Name="{Binding Tooltip}" Background="{Binding Brush}"
                                                    Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Hex}"
                                                    ToolTip="{Binding Tooltip}"
                                                    Style="{StaticResource QuickColorChipStyle}"
                                                    Width="20" Height="20"
                                                    Margin="2,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Hex TextBox (Row) -->
                    <TextBox AutomationProperties.Name="{Binding Label, StringFormat={}{0} hex color}" Grid.Column="1"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource EditorTextBoxStyle}"
                             FontFamily="Consolas, Segoe UI"
                             FontSize="11.5"
                             VerticalContentAlignment="Center"
                             Padding="8,2"
                             Height="28"
                             Margin="6,0,6,0"/>

                    <!-- Reset Button (Row) -->
                    <Button AutomationProperties.Name="{Binding ResetTooltip}" Grid.Column="2"
                            Content="{Binding ResetLabel}"
                            ToolTip="{Binding ResetTooltip}"
                            Command="{Binding ResetCommand}"
                            Style="{StaticResource EditorSecondaryButtonStyle}"
                            Height="28"
                            Padding="8,0"
                            VerticalAlignment="Center"
                            FontSize="11"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ExplorerColumn" Width="332" MinWidth="240" MaxWidth="340"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="InspectorColumn" Width="334" MinWidth="285" MaxWidth="420"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!--  1. Studio Header Bar                                        -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Grid.ColumnSpan="3"
                Background="{StaticResource EditorMaterial}"
                BorderBrush="{StaticResource EditorBorder}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="490"/>
                </Grid.ColumnDefinitions>

                <Grid VerticalAlignment="Center" Margin="8,0,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="8" Background="Black" Margin="0,0,12,0">
                        <Image Source="{StaticResource AppLogo}" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="AdaptiveBar NT logo"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="AdaptiveBar Studio" Foreground="{StaticResource PrimaryText}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                    <Border x:Name="ContextBreadcrumb" Grid.Column="2" BorderBrush="{StaticResource EditorBorder}" BorderThickness="1,0,0,0" Padding="20,0,0,0" Margin="24,0,0,0" MaxWidth="260" HorizontalAlignment="Left">
                        <DockPanel><TextBlock DockPanel.Dock="Left" Text="&#xE7F4;" Style="{StaticResource StudioIcon}" Foreground="{StaticResource TextMuted}" Margin="0,0,12,0"/><TextBlock Text="{Binding ActiveContext}" ToolTip="{Binding ActiveContext}" Foreground="{StaticResource PrimaryText}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
                    </Border>
                </Grid>
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource EditorInput}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="6,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Margin="0,0,10,0"><Ellipse.Style><Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource StatusSuccess}"/><Style.Triggers><DataTrigger Binding="{Binding IsDirty}" Value="True"><Setter Property="Fill" Value="{StaticResource StatusWarning}"/></DataTrigger></Style.Triggers>
                        </Style></Ellipse.Style></Ellipse>
                        <TextBlock Text="{Binding DirtyLabel}" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
<Button x:Name="UndoButton" Command="{Binding UndoCommand}" Style="{StaticResource EditorButtonStyle}" MinHeight="40" Margin="0,0,6,0" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo last edit"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A7;" Style="{StaticResource StudioIcon}"/><TextBlock Text="Undo" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button><Button x:Name="RedoButton" Command="{Binding RedoCommand}" Style="{StaticResource EditorButtonStyle}" MinHeight="40" Margin="0,0,6,0" ToolTip="Redo (Ctrl+Y / Ctrl+Shift+Z)" AutomationProperties.Name="Redo last edit"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A6;" Style="{StaticResource StudioIcon}"/><TextBlock Text="Redo" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button><Button Click="ReloadButton_OnClick" Style="{StaticResource EditorButtonStyle}" MinHeight="40" Margin="0,0,6,0" ToolTip="Reload" AutomationProperties.Name="Reload"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource StudioIcon}"/><TextBlock Text="Reload" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button><Button Command="{Binding ValidateCommand}" Style="{StaticResource EditorButtonStyle}" MinHeight="40" Margin="0,0,6,0" ToolTip="Validate" AutomationProperties.Name="Validate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource StudioIcon}"/><TextBlock Text="Validate" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button><Button Command="{Binding SaveCommand}" Style="{StaticResource EditorPrimaryButtonStyle}" MinHeight="40" Margin="0,0,6,0" ToolTip="Save profile (Ctrl+S)" AutomationProperties.Name="Save profile"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource StudioIcon}"/><TextBlock Text="Save" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!--  2. Left Panel: Segmented Explorer / Widget Library          -->
        <!-- ============================================================ -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{StaticResource EditorPanel}"
                BorderBrush="{StaticResource EditorBorder}"
                BorderThickness="0,0,1,0">
            <TabControl SelectedIndex="{Binding SelectedLeftTabIndex, Mode=TwoWay}"
                        Style="{StaticResource DesignerTabControlStyle}"
                        ItemContainerStyle="{StaticResource DesignerTabItemStyle}">

                <!-- Tab 1: Explorer (Profiles, Pages, Current Widgets) -->
                <TabItem ToolTip="Explorer" AutomationProperties.Name="Explorer"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="ExplorerTabLabel" Text="Explorer" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                    <ScrollViewer PanningMode="VerticalFirst" x:Name="ExplorerScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid MinHeight="480" Height="{Binding ViewportHeight, ElementName=ExplorerScroll}">
                        <Grid.RowDefinitions><RowDefinition Height="1.8*" MinHeight="180"/><RowDefinition Height="1.15*" MinHeight="140"/><RowDefinition Height="*" MinHeight="140"/></Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <Border DockPanel.Dock="Top"><DockPanel Margin="22,12,14,8" LastChildFill="True"><Button DockPanel.Dock="Right" Click="DeleteProfileButton_OnClick" Style="{StaticResource StudioIconButton}" Margin="8,0,0,0" ToolTip="Delete selected profile" AutomationProperties.Name="Delete selected profile"><TextBlock Text="&#xE74D;" Style="{StaticResource StudioIcon}"/></Button><Button DockPanel.Dock="Right" Click="NewProfile_OnClick" Style="{StaticResource StudioIconButton}" AutomationProperties.Name="New profile for an application" ToolTip="New profile for an application"><TextBlock Text="&#xE710;" Style="{StaticResource StudioIcon}"/></Button><TextBlock Text="PROFILES" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/></DockPanel></Border>
                            <ListBox x:Name="ProfilesList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=OneWay}" SelectionChanged="ProfilesList_OnSelectionChanged" Style="{StaticResource EditorListBoxStyle}" ItemContainerStyle="{StaticResource EditorListItemStyle}" Margin="12,0,12,8" AutomationProperties.Name="Profiles">
                                <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding DisplayName}"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding ., Converter={StaticResource StudioItem}, ConverterParameter=ProfileIcon}" Style="{StaticResource StudioIcon}" HorizontalAlignment="Left"/>
    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,4,0"/>
    <Button Grid.Column="2" Tag="Profile" Click="ItemMenu_OnClick" Style="{StaticResource StudioIconButton}" Width="44" BorderThickness="0" AutomationProperties.Name="Profile actions" ToolTip="Profile actions"><TextBlock Text="&#xE712;" Style="{StaticResource StudioIcon}"/></Button>
    </Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        <Border Grid.Row="1" BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,1,0,0"><DockPanel>
                            <Border DockPanel.Dock="Top"><DockPanel Margin="22,12,14,8" LastChildFill="True"><Button DockPanel.Dock="Right" Command="{Binding AddPageCommand}" Style="{StaticResource StudioIconButton}" AutomationProperties.Name="Add new page" ToolTip="Add new page"><TextBlock Text="&#xE710;" Style="{StaticResource StudioIcon}"/></Button><TextBlock Text="PAGES" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/></DockPanel></Border>
                            <ListBox x:Name="PagesList" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}" Style="{StaticResource EditorListBoxStyle}" ItemContainerStyle="{StaticResource EditorListItemStyle}" Margin="12,0,12,8" AutomationProperties.Name="Pages">
                                <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding DisplayName}"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding ., Converter={StaticResource StudioItem}, ConverterParameter=PageIcon}" Style="{StaticResource StudioIcon}" HorizontalAlignment="Left"/>
    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,4,0"/>
    <Button Grid.Column="2" Tag="Page" Click="ItemMenu_OnClick" Style="{StaticResource StudioIconButton}" Width="44" BorderThickness="0" AutomationProperties.Name="Page actions" ToolTip="Page actions"><TextBlock Text="&#xE712;" Style="{StaticResource StudioIcon}"/></Button>
    </Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel></Border>
                        <Border Grid.Row="2" BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,1,0,0"><DockPanel>
                            <Border DockPanel.Dock="Top"><DockPanel Margin="22,12,14,8" LastChildFill="True"><Button DockPanel.Dock="Right" Click="OpenLibrary_OnClick" Style="{StaticResource StudioIconButton}" AutomationProperties.Name="Open widget library" ToolTip="Open widget library"><TextBlock Text="&#xE710;" Style="{StaticResource StudioIcon}"/></Button><Border DockPanel.Dock="Right" Background="{StaticResource EditorInput}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0"><TextBlock Text="{Binding CurrentWidgets.Count}" Foreground="{StaticResource PrimaryText}" FontSize="13" VerticalAlignment="Center"/></Border><TextBlock Text="PAGE WIDGETS" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/></DockPanel></Border>
                            <ListBox x:Name="WidgetsList" ItemsSource="{Binding CurrentWidgets}" SelectedItem="{Binding SelectedWidget, Mode=TwoWay}" Style="{StaticResource EditorListBoxStyle}" ItemContainerStyle="{StaticResource EditorListItemStyle}" Margin="12,0,12,8" AutomationProperties.Name="Page widgets">
                                <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding ., Converter={StaticResource StudioItem}}"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
    <ContentControl Content="{Binding .}" ContentTemplate="{StaticResource StudioWidgetIcon}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" Text="{Binding ., Converter={StaticResource StudioItem}}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,4,0"/>
    <Button Grid.Column="2" Tag="Widget" Click="ItemMenu_OnClick" Style="{StaticResource StudioIconButton}" Width="44" BorderThickness="0" AutomationProperties.Name="Widget actions" ToolTip="Widget actions"><TextBlock Text="&#xE712;" Style="{StaticResource StudioIcon}"/></Button>
    </Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel></Border>
                    </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: Widget Library (Catalog / Palette) -->
                <TabItem ToolTip="Library" AutomationProperties.Name="Library"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="LibraryTabLabel" Text="Library" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="12,10,12,6">
                            <StackPanel>
                                <TextBlock Text="WIDGET PALETTE" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,2"/>
                                <TextBlock Text="Drag onto the preview surface or double-click to insert."
                                           Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="PaletteList"
                                 Grid.Row="1"
                                 ItemsSource="{Binding Palette}"
                                 SelectedItem="{Binding SelectedPaletteDefinition, Mode=TwoWay}"
                                 PreviewMouseLeftButtonDown="PaletteList_OnPreviewMouseLeftButtonDown"
                                 PreviewMouseMove="PaletteList_OnPreviewMouseMove"
                                 PreviewMouseLeftButtonUp="PaletteList_OnPreviewMouseLeftButtonUp"
                                 MouseDoubleClick="PaletteList_OnMouseDoubleClick"
                                 Style="{StaticResource EditorListBoxStyle}"
                                 ItemContainerStyle="{StaticResource EditorListItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" FontSize="11.5"/>
                                            <TextBlock Text="{Binding TypeId}" Foreground="{StaticResource TextMuted}" FontSize="9.5" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource EditorInput}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" Foreground="{StaticResource EditorAccentText}" FontSize="9.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,1,0,0" Padding="12,8">
                            <Button Content="+ Add to Page"
                                    Command="{Binding AddWidgetCommand}"
                                    Style="{StaticResource EditorPrimaryButtonStyle}"
                                    HorizontalAlignment="Stretch"/>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 3: Shared input tools -->
                <TabItem ToolTip="Input" AutomationProperties.Name="Input"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="InputTabLabel" Text="Input" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                    <ScrollViewer PanningMode="VerticalFirst" x:Name="InputScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid MinHeight="380" Height="{Binding ViewportHeight, ElementName=InputScroll}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="12,10,12,8">
                            <StackPanel>
                                <TextBlock Text="INPUT TOOLS" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,2"/>
                                <TextBlock Text="Shared across every profile and shown automatically while typing."
                                           Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="8,0,8,10">
                            <Border Background="{StaticResource EditorInput}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Emoji" FontWeight="SemiBold" FontSize="11.5"/>
                                        <TextBlock Text="Picker" Foreground="{StaticResource TextMuted}" FontSize="9.5"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="AUTO" Foreground="{StaticResource EditorAccentText}" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Background="{StaticResource EditorInput}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Clipboard" FontWeight="SemiBold" FontSize="11.5"/>
                                        <TextBlock Text="Recent copied text" Foreground="{StaticResource TextMuted}" FontSize="9.5"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="AUTO" Foreground="{StaticResource EditorAccentText}" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border Grid.Row="2" BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,1,0,0" Padding="12,10,12,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CUSTOM INPUT" Style="{StaticResource SectionLabelStyle}" Margin="0" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#1C1C24" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8" Padding="7,1">
                                    <TextBlock Text="{Binding InputItems.Count}" Foreground="{StaticResource SecondaryText}" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3">
                            <TextBlock Text="Add a reusable text slot or sticker below."
                                       Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InputItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ListBox ItemsSource="{Binding InputItems}"
                                     SelectedItem="{Binding SelectedWidget, Mode=TwoWay}"
                                     Style="{StaticResource EditorListBoxStyle}"
                                     ItemContainerStyle="{StaticResource EditorListItemStyle}"
                                     Margin="4,0,4,4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ControlDefinition}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="#1C1C24" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding Type}" Foreground="{StaticResource SecondaryText}" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Border Grid.Row="4" BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,1,0,0" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="+ Text Slot" Command="{Binding AddTextSlotCommand}"
                                        Style="{StaticResource EditorPrimaryButtonStyle}" Margin="0,0,4,0" MinHeight="40"/>
                                <Button Grid.Column="1" Content="+ Sticker" Command="{Binding AddStickerCommand}"
                                        Style="{StaticResource EditorSecondaryButtonStyle}" Margin="4,0,0,0" MinHeight="40"/>
                            </Grid>
                        </Border>
                    </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- ============================================================ -->
        <!--  3. Center: Preview Workspace Shell                          -->
        <!-- ============================================================ -->
        <Grid x:Name="CanvasWorkspace" Grid.Row="1" Grid.Column="1" Background="{StaticResource WorkbenchGridBrush}" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border IsHitTestVisible="False"><Border.Background><RadialGradientBrush RadiusX="0.55" RadiusY="0.55"><GradientStop Color="#A038424F" Offset="0"/><GradientStop Color="#2038424F" Offset="0.65"/><GradientStop Color="#0038424F" Offset="1"/></RadialGradientBrush></Border.Background></Border>
            <ScrollViewer x:Name="CanvasViewport" Grid.Row="0" Margin="0,72,0,72" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False"
                          SizeChanged="CanvasViewport_OnSizeChanged" PreviewMouseWheel="CanvasViewport_OnMouseWheel" PreviewMouseLeftButtonDown="CanvasViewport_OnMouseDown" PreviewMouseMove="CanvasViewport_OnMouseMove" PreviewMouseLeftButtonUp="CanvasViewport_OnMouseUp" LostMouseCapture="CanvasViewport_OnLostMouseCapture" Focusable="True" AutomationProperties.Name="Preview canvas">
                <Grid x:Name="CanvasExtent" Background="Transparent">
                <Border x:Name="HardwareFrame" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" SizeChanged="HardwareFrame_OnSizeChanged" BorderBrush="#FF46505B" BorderThickness="1" CornerRadius="16" Padding="16,20">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF39434E" Offset="0"/><GradientStop Color="#FF20262D" Offset="0.06"/><GradientStop Color="#FF171C21" Offset="0.85"/><GradientStop Color="#FF303840" Offset="1"/></LinearGradientBrush></Border.Background>
                    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.45" Color="#000000"/></Border.Effect>
                    <Border.LayoutTransform><ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1"/></Border.LayoutTransform>
                    <StackPanel>
                        <!-- Chassis Header Bar: Hardware identity & Dimension tag -->
                        <Grid Height="52" Margin="4,0,4,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="ADAPTIVEBAR HARDWARE SURFACE"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#227C5CFC"
                                    BorderBrush="#407C5CFC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,6" VerticalAlignment="Center">
                                <TextBlock Text="1280 × 72 DIP"
                                           Foreground="{StaticResource EditorAccentText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <!-- The authentic 1280 x 72 Preview Surface Well. The stage grows only while
                             the background-media framing control is active, exposing overflow around
                             the real bar bounds without changing the runtime surface dimensions. -->
                        <Grid x:Name="PreviewMediaStage"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Background="#FF09090E"
                              ClipToBounds="True">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Width" Value="1280"/>
                                    <Setter Property="Height" Value="72"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsChecked, ElementName=BackgroundMediaEditToggle}" Value="True"/>
                                                <Condition Binding="{Binding SelectedRightTabIndex}" Value="1"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Width" Value="1440"/>
                                            <Setter Property="Height" Value="216"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsDecorativeMediaEditMode}" Value="True"/>
                                                <Condition Binding="{Binding SelectedRightTabIndex}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Width" Value="1440"/>
                                            <Setter Property="Height" Value="216"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Border x:Name="PreviewSurface"
                                    Width="1280" Height="72"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SurfaceBase}"
                                    BorderBrush="{DynamicResource ShellBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ShellCornerRadius}"
                                    Padding="0"
                                    AllowDrop="True"
                                    DragOver="PreviewSurface_OnDragOver"
                                    DragLeave="PreviewSurface_OnDragLeave"
                                    Drop="PreviewSurface_OnDrop">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="ClipToBounds" Value="True"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsChecked, ElementName=BackgroundMediaEditToggle}" Value="True"/>
                                                    <Condition Binding="{Binding SelectedRightTabIndex}" Value="1"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="ClipToBounds" Value="False"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDecorativeMediaEditMode}" Value="True"/>
                                                    <Condition Binding="{Binding SelectedRightTabIndex}" Value="0"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="ClipToBounds" Value="False"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            <Grid>
                                <controls:DecorativeMediaView Source="{Binding AppearanceEditor.BackgroundMediaResolvedSource}"
                                                              Fit="{Binding AppearanceEditor.BackgroundMediaFit}"
                                                              Loop="{Binding AppearanceEditor.BackgroundMediaLoop}"
                                                              MediaEnabled="{Binding AppearanceEditor.BackgroundMediaEnabled}"
                                                              MediaOpacity="{Binding AppearanceEditor.BackgroundMediaOpacity}"
                                                              HorizontalOffset="{Binding AppearanceEditor.BackgroundMediaOffsetX}"
                                                              VerticalOffset="{Binding AppearanceEditor.BackgroundMediaOffsetY}"
                                                              Zoom="{Binding AppearanceEditor.BackgroundMediaZoom}"
                                                              ClipToBounds="False"
                                                              MotionEnabled="{Binding AppearanceEditor.MotionEnabled}"/>

                                <Grid x:Name="PreviewContentGrid" Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="124"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Profile branding block -->
                                <Grid Grid.Column="0" Margin="2,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProfileDisplayName}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PageDisplayName}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="10.5"
                                                   Margin="0,1,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Rectangle Grid.Column="1"
                                               Width="1"
                                               Height="18"
                                               Fill="{DynamicResource Divider}"
                                               Margin="8,0,2,0"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <ItemsControl x:Name="FixedLeftPreviewItems"
                                              Grid.Column="1"
                                              ItemsSource="{Binding FixedLeftPreviewItems}"
                                              ItemTemplate="{StaticResource DesignerPreviewItemTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <!-- Main preview widgets scroll host -->
                                <ScrollViewer x:Name="MainPreviewHost"
                                              Grid.Column="2"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="MainPreviewItems"
                                                  ItemsSource="{Binding PreviewItems}"
                                                  ItemTemplate="{StaticResource DesignerPreviewItemTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- System pinned widgets host -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Rectangle Width="1" Height="18" Fill="{StaticResource Divider}" Margin="4,0,6,0">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding FixedRightPreviewItems.Count}" Value="0"/>
                                                            <Condition Binding="{Binding SystemPreviewItems.Count}" Value="0"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <ItemsControl x:Name="FixedRightPreviewItems"
                                                  ItemsSource="{Binding FixedRightPreviewItems}"
                                                  ItemTemplate="{StaticResource DesignerPreviewItemTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <ItemsControl x:Name="SystemPreviewItems"
                                                  ItemsSource="{Binding SystemPreviewItems}"
                                                  ItemTemplate="{StaticResource DesignerPreviewItemTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Drop insertion indicator -->
                                <Canvas Grid.ColumnSpan="4" IsHitTestVisible="False">
                                    <Rectangle x:Name="DropIndicator"
                                               Width="2"
                                               Height="48"
                                               RadiusX="1"
                                               RadiusY="1"
                                               Fill="{StaticResource AccentBrush}"
                                               Visibility="Collapsed"
                                               Canvas.Top="2"/>
                                </Canvas>
                                </Grid>
                            </Grid>
                            </Border>

                            <!-- Dim only the area outside the physical bar while framing media. -->
                            <Grid IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsChecked, ElementName=BackgroundMediaEditToggle}" Value="True"/>
                                                    <Condition Binding="{Binding SelectedRightTabIndex}" Value="1"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDecorativeMediaEditMode}" Value="True"/>
                                                    <Condition Binding="{Binding SelectedRightTabIndex}" Value="0"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Border Height="72" VerticalAlignment="Top" Background="#A0000000"/>
                                <Border Height="72" VerticalAlignment="Bottom" Background="#A0000000"/>
                                <Border Width="80" Height="72" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#A0000000"/>
                                <Border Width="80" Height="72" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#A0000000"/>
                            </Grid>

                            <!-- Editing edge: exact runtime bar bounds. -->
                            <Border Width="1280"
                                    Height="72"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BorderBrush="{StaticResource AccentPrimary}"
                                    BorderThickness="2"
                                    CornerRadius="{DynamicResource ShellCornerRadius}"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsChecked, ElementName=BackgroundMediaEditToggle}" Value="True"/>
                                                    <Condition Binding="{Binding SelectedRightTabIndex}" Value="1"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDecorativeMediaEditMode}" Value="True"/>
                                                    <Condition Binding="{Binding SelectedRightTabIndex}" Value="0"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>

                    </StackPanel>
                </Border>
                </Grid>
            </ScrollViewer>
            <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12,24,12,0" Background="{StaticResource EditorMaterial}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="1" CornerRadius="12" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SelectModeButton" GroupName="CanvasMode" IsChecked="True" Checked="CanvasMode_OnChecked" Style="{StaticResource StudioModeButton}" AutomationProperties.Name="Select widgets" ToolTip="Select widgets"><TextBlock Text="&#xE8B0;" Style="{StaticResource StudioIcon}"/></RadioButton>
                    <RadioButton x:Name="PanModeButton" GroupName="CanvasMode" Checked="CanvasMode_OnChecked" Style="{StaticResource StudioModeButton}" AutomationProperties.Name="Pan canvas" ToolTip="Pan canvas (hold Space)"><TextBlock Text="&#xE7C9;" Style="{StaticResource StudioIcon}"/></RadioButton>
                    <Border Width="1" Height="28" Background="{StaticResource EditorBorder}" Margin="4,0"/>
                    <ComboBox x:Name="ZoomPicker" Width="100" MinHeight="40" Background="Transparent" BorderThickness="0" Style="{StaticResource EditorComboBoxStyle}" SelectionChanged="ZoomPicker_OnSelectionChanged" AutomationProperties.Name="Canvas zoom" ToolTip="Canvas zoom (Ctrl + mouse wheel)">
                        <ComboBoxItem Content="Fit" Tag="fit"/><ComboBoxItem Content="10%" Tag="0.1"/><ComboBoxItem Content="25%" Tag="0.25"/><ComboBoxItem Content="50%" Tag="0.5"/><ComboBoxItem Content="75%" Tag="0.75"/><ComboBoxItem Content="100%" Tag="1"/><ComboBoxItem Content="150%" Tag="1.5"/><ComboBoxItem Content="200%" Tag="2"/>
                        <ComboBoxItem x:Name="CurrentZoomItem" Content="Fit"/>
                    </ComboBox>
                    <Button x:Name="ZoomOutButton" Click="ZoomOut_OnClick" Style="{StaticResource CanvasToolButton}" AutomationProperties.Name="Zoom out" ToolTip="Zoom out"><TextBlock Text="&#xE71F;" Style="{StaticResource StudioIcon}"/></Button>
                    <Button x:Name="ZoomInButton" Click="ZoomIn_OnClick" Style="{StaticResource CanvasToolButton}" AutomationProperties.Name="Zoom in" ToolTip="Zoom in"><TextBlock Text="&#xE8A3;" Style="{StaticResource StudioIcon}"/></Button>
                    <Button x:Name="FitButton" Click="Fit_OnClick" Style="{StaticResource CanvasToolButton}" AutomationProperties.Name="Fit preview to viewport" ToolTip="Fit preview to viewport"><Path Data="M 0 7 L 0 0 L 7 0 M 13 0 L 20 0 L 20 7 M 20 13 L 20 20 L 13 20 M 7 20 L 0 20 L 0 13" Stroke="{StaticResource PrimaryText}" StrokeThickness="1.5" Width="20" Height="20"/></Button>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource EditorBackground}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="16,100,16,16">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Document}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280">
                    <TextBlock Text="Create your first profile" Foreground="{StaticResource PrimaryText}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="Choose an application, then build its AdaptiveBar with widgets from the Library." Foreground="{StaticResource SecondaryText}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,24"/>
                    <Button Content="Choose application…" Click="NewProfile_OnClick" Style="{StaticResource EditorPrimaryButtonStyle}" AutomationProperties.Name="Create first profile"/>
                </StackPanel>
            </Border>
            <!-- Workspace instruction footer pill -->
            <Border Grid.Row="1" HorizontalAlignment="Center" Margin="12,0,12,16"
                    Background="{StaticResource EditorPanelRaised}"
                    BorderBrush="{StaticResource EditorBorder}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="22,7">
                <TextBlock Text="Drag to reorder · Drop from Library · Drag edge to resize · Space to pan"
                           Foreground="{StaticResource SecondaryText}"
                           FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>
        </Grid>

        <!-- ============================================================ -->
        <!--  4. Right Panel: Tabbed Inspector (Properties / Appearance)  -->
        <!-- ============================================================ -->
        <Border Grid.Row="1" Grid.Column="2"
                Background="{StaticResource EditorPanel}"
                BorderBrush="{StaticResource EditorBorder}"
                BorderThickness="1,0,0,0">
            <TabControl SelectedIndex="{Binding SelectedRightTabIndex, Mode=TwoWay}"
                        Style="{StaticResource DesignerTabControlStyle}"
                        ItemContainerStyle="{StaticResource DesignerTabItemStyle}">
                <!-- Tab 1: Properties -->
                <TabItem AutomationProperties.Name="Properties"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Properties" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                    <ScrollViewer PanningMode="VerticalFirst" VerticalScrollBarVisibility="Auto">
                <Grid Margin="14,12,14,18">
                    <StackPanel>


                        <!-- Widget Selected: Grouped Inspector Cards -->
                        <StackPanel DataContext="{Binding SelectedWidgetEditor}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Border Style="{StaticResource InspectorCardStyle}" Padding="12" ToolTip="{Binding Id}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource EditorInput}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="1" CornerRadius="8" Height="56"><ContentControl Content="{Binding Model}" ContentTemplate="{StaticResource StudioWidgetIcon}" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="{Binding Definition.DisplayName}" Foreground="{StaticResource PrimaryText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource InspectorCardStyle}"><StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><TextBlock Text="&#xE81D;" Style="{StaticResource InspectorSectionIcon}"/><TextBlock Text="Placement" Foreground="{StaticResource PrimaryText}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/></StackPanel>
                                <ComboBox AutomationProperties.Name="Widget placement" ItemsSource="{Binding PlacementOptions}" SelectedItem="{Binding Placement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorComboBoxStyle}"/>
                                <TextBlock Text="{Binding PlacementDescription}" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                
                            </StackPanel></Border>
                            <!-- Card 2: Layout & Sizing -->
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource InspectorCardStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasEditableWidth}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="&#xE8A9;" Style="{StaticResource InspectorSectionIcon}"/><TextBlock Text="Layout" Foreground="{StaticResource PrimaryText}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/></StackPanel>
                                    <TextBlock Text="Width (DIP)" Style="{StaticResource InspectorLabelStyle}"/>
                                    <Grid>
                                        <TextBox AutomationProperties.Name="Widget width in DIP" AutomationProperties.HelpText="{Binding WidthHint}" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorTextBoxStyle}" Padding="12,5,38,5"/>
                                        <StackPanel HorizontalAlignment="Right" Margin="1">
                                            <RepeatButton Tag="1" Click="WidthStep_OnClick" Style="{StaticResource WidthStepStyle}" IsEnabled="{Binding CanIncreaseWidth}" AutomationProperties.Name="Increase width" ToolTip="Increase width"><Path Data="M 0 4 L 4 0 L 8 4" Stroke="{StaticResource PrimaryText}" StrokeThickness="1.2"/></RepeatButton>
                                            <RepeatButton Tag="-1" Click="WidthStep_OnClick" Style="{StaticResource WidthStepStyle}" IsEnabled="{Binding CanDecreaseWidth}" AutomationProperties.Name="Decrease width" ToolTip="Decrease width"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource PrimaryText}" StrokeThickness="1.2"/></RepeatButton>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding WidthError}" Foreground="{StaticResource EditorErrorText}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding WidthError}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    <TextBlock Text="{Binding WidthHint}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Content & Appearance -->
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource InspectorCardStyle}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasLabel}" Value="False"/>
                                                    <Condition Binding="{Binding HasIcon}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="APPEARANCE" Foreground="{StaticResource SecondaryText}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,6"/>

                                    <!-- Label field -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasLabel}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Label" Style="{StaticResource InspectorLabelStyle}"/>
                                        <TextBox AutomationProperties.Name="Widget label" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextBoxStyle}"/>
                                    </StackPanel>

                                    <!-- Icon fields -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Icon Kind" Style="{StaticResource InspectorLabelStyle}"/>
                                        <ComboBox AutomationProperties.Name="Icon kind" SelectedValue="{Binding IconKind, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Content"
                                                  Style="{StaticResource EditorComboBoxStyle}">
                                            <ComboBoxItem Content="none"/>
                                            <ComboBoxItem Content="glyph"/>
                                            <ComboBoxItem Content="asset"/>
                                        </ComboBox>
                                        <TextBlock Text="Icon" Style="{StaticResource InspectorLabelStyle}"/>
                                        <Grid>
                                            <Button AutomationProperties.Name="Choose an icon" x:Name="IconPickerButton"
                                                    Command="{Binding ToggleIconPickerCommand}"
                                                    Style="{StaticResource EditorPickerButtonStyle}"
                                                    ToolTip="Choose an icon">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24" Height="24"
                                                            Background="{StaticResource EditorSelection}"
                                                            CornerRadius="4">
                                                        <TextBlock Text="{Binding SelectedIconGlyph}"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="15"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="7,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedIconDisplayName}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="Choose from icon library"
                                                                   Foreground="{StaticResource TextMuted}"
                                                                   FontSize="10"/>
                                                    </StackPanel>
                                                    <Path Grid.Column="2"
                                                          Data="M 0 0 L 4 4 L 8 0"
                                                          Stroke="{StaticResource SecondaryText}"
                                                          StrokeThickness="1.5"
                                                          VerticalAlignment="Center"
                                                          Margin="8,0,2,0"/>
                                                </Grid>
                                            </Button>

                                            <Popup x:Name="IconPickerPopup"
                                                   IsOpen="{Binding IsIconPickerOpen, Mode=TwoWay}"
                                                   PlacementTarget="{Binding ElementName=IconPickerButton}"
                                                   Placement="Left"
                                                   HorizontalOffset="-8"
                                                   StaysOpen="False"
                                                   AllowsTransparency="True">
                                                <Border Width="360"
                                                        PreviewKeyDown="Designer_OnPreviewKeyDown"
                                                        MaxHeight="520"
                                                        Background="{StaticResource EditorPanelRaised}"
                                                        BorderBrush="{StaticResource EditorBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="12">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.85" Color="#000000"/>
                                                    </Border.Effect>
                                                    <DockPanel LastChildFill="True">
                                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="CHOOSE ICON"
                                                                       Foreground="{StaticResource SecondaryText}"
                                                                       FontSize="10.5"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1"
                                                                    Content="Clear"
                                                                    Command="{Binding ClearIconCommand}"
                                                                    Style="{StaticResource EditorSecondaryButtonStyle}"
                                                                    Padding="8,3"/>
                                                        </Grid>
                                                        <TextBox AutomationProperties.Name="Search icons" DockPanel.Dock="Top"
                                                                 Text="{Binding IconSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource EditorTextBoxStyle}"
                                                                 ToolTip="Search icons by name or category"
                                                                 Margin="0,0,0,8"/>
                                                        <ScrollViewer PanningMode="VerticalFirst" MaxHeight="420"
                                                                      HorizontalScrollBarVisibility="Disabled"
                                                                      VerticalScrollBarVisibility="Auto">
                                                            <ItemsControl ItemsSource="{Binding FilteredIconGroups}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Margin="0,0,0,8">
                                                                            <TextBlock Text="{Binding Category}"
                                                                                       Foreground="{StaticResource TextMuted}"
                                                                                       FontSize="10"
                                                                                       FontWeight="SemiBold"
                                                                                       Margin="2,0,0,3"/>
                                                                            <ItemsControl ItemsSource="{Binding Items}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel/>
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Button AutomationProperties.Name="{Binding Name}" Style="{StaticResource EditorIconTileStyle}"
                                                                                                Click="IconTile_OnClick"
                                                                                                ToolTip="{Binding Name}">
                                                                                            <TextBlock Text="{Binding DisplayGlyph}"
                                                                                                       FontFamily="Segoe MDL2 Assets"
                                                                                                       FontSize="16"/>
                                                                                        </Button>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </DockPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <TextBlock Text="Icon Value" Style="{StaticResource InspectorLabelStyle}"/>
                                        <TextBox AutomationProperties.Name="Icon value" Text="{Binding IconValue, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextBoxStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Decorative media settings -->
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource InspectorCardStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDecorativeMediaSettings}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <ToggleButton AutomationProperties.Name="Show decorative-media overflow and framing guides" x:Name="DecorativeMediaEditToggle"
                                                  IsChecked="{Binding DataContext.IsDecorativeMediaEditMode, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="0"
                                                  Margin="-4,-3,-4,8"
                                                  Cursor="Hand"
                                                  FocusVisualStyle="{x:Null}"
                                                  ToolTip="Show decorative-media overflow and framing guides">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="DecorativeMediaHeader" BorderThickness="1" BorderBrush="Transparent"
                                                        Background="Transparent"
                                                        CornerRadius="6"
                                                        Padding="4,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="DECORATIVE MEDIA"
                                                                   Foreground="{StaticResource SecondaryText}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="EDIT FRAME"
                                                                   Foreground="{StaticResource TextMuted}"
                                                                   FontSize="9.5"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="DecorativeMediaHeader" Property="Background" Value="#14FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="DecorativeMediaHeader" Property="Background" Value="{StaticResource AccentSubtle}"/>
                                                    </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="DecorativeMediaHeader" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                                </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <TextBlock Text="Source" Style="{StaticResource InspectorLabelStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox AutomationProperties.Name="Media source" Grid.Column="0"
                                                 Text="{Binding MediaSource, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextBoxStyle}"
                                                 Margin="0,0,6,0"/>
                                        <Button IsEnabled="{Binding DataContext.IsMediaImportAvailable, RelativeSource={RelativeSource AncestorType=Window}}" Grid.Column="1"
                                                Content="Browse"
                                                Click="BrowseMediaButton_OnClick"
                                                Style="{StaticResource EditorSecondaryButtonStyle}"/>
                                    </Grid>

                                    <TextBlock Text="Fit" Style="{StaticResource InspectorLabelStyle}"/>
                                    <ComboBox AutomationProperties.Name="Media fit" SelectedValue="{Binding MediaFit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Tag"
                                              Style="{StaticResource EditorComboBoxStyle}">
                                        <ComboBoxItem Content="Contain" Tag="contain"/>
                                        <ComboBoxItem Content="Cover" Tag="cover"/>
                                        <ComboBoxItem Content="Fill" Tag="fill"/>
                                    </ComboBox>

                                    <CheckBox AutomationProperties.Name="Loop media" Content="Loop"
                                              IsChecked="{Binding MediaLoop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,10,0,0"/>

                                    <TextBlock Text="Opacity" Style="{StaticResource InspectorLabelStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider AutomationProperties.Name="Media opacity" Grid.Column="0"
                                                Minimum="0"
                                                Maximum="1"
                                                Value="{Binding MediaOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding MediaOpacity, StringFormat={}{0:P0}}"
                                                   Foreground="{StaticResource PrimaryText}"
                                                   FontFamily="Consolas, Segoe UI"
                                                   FontSize="11"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <CheckBox AutomationProperties.Name="Enable media" Content="Enabled"
                                              IsChecked="{Binding MediaEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,10,0,0"/>

                                    <Grid Margin="0,10,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ZOOM" Foreground="{StaticResource SecondaryText}" FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MediaZoom, StringFormat='{}{0:P0}'}" Foreground="{StaticResource PrimaryText}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button AutomationProperties.Name="Reset zoom to 100%" Grid.Column="2"
                                                Content="↺"
                                                ToolTip="Reset zoom to 100%"
                                                Command="{Binding ResetMediaZoomCommand}"
                                                Style="{StaticResource EditorSecondaryButtonStyle}"
                                                Padding="6,1"/>
                                    </Grid>
                                    <Slider AutomationProperties.Name="Media zoom" Minimum="0.1" Maximum="4" TickFrequency="0.05"
                                            Value="{Binding MediaZoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Grid Margin="0,8,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="HORIZONTAL POSITION" Foreground="{StaticResource SecondaryText}" FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MediaOffsetX, StringFormat='{}{0:F0} px'}" Foreground="{StaticResource PrimaryText}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button AutomationProperties.Name="Reset horizontal position" Grid.Column="2"
                                                Content="↺"
                                                ToolTip="Reset horizontal position"
                                                Command="{Binding ResetMediaHorizontalCommand}"
                                                Style="{StaticResource EditorSecondaryButtonStyle}"
                                                Padding="6,1"/>
                                    </Grid>
                                    <Slider AutomationProperties.Name="Media horizontal position" Minimum="-1280" Maximum="1280" TickFrequency="1"
                                            Value="{Binding MediaOffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Grid Margin="0,8,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="VERTICAL POSITION" Foreground="{StaticResource SecondaryText}" FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MediaOffsetY, StringFormat='{}{0:F0} px'}" Foreground="{StaticResource PrimaryText}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button AutomationProperties.Name="Reset vertical position" Grid.Column="2"
                                                Content="↺"
                                                ToolTip="Reset vertical position"
                                                Command="{Binding ResetMediaVerticalCommand}"
                                                Style="{StaticResource EditorSecondaryButtonStyle}"
                                                Padding="6,1"/>
                                    </Grid>
                                    <Slider AutomationProperties.Name="Media vertical position" Minimum="-72" Maximum="72" TickFrequency="1"
                                            Value="{Binding MediaOffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Border>

                            <!-- Sticker image source -->
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource InspectorCardStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasStickerSettings}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="STICKER" Foreground="{StaticResource SecondaryText}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock Text="PNG/JPEG source" Style="{StaticResource InspectorLabelStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox AutomationProperties.Name="Media source" Text="{Binding MediaSource, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextBoxStyle}"
                                                 Margin="0,0,6,0"/>
                                        <Button IsEnabled="{Binding DataContext.IsMediaImportAvailable, RelativeSource={RelativeSource AncestorType=Window}}" Grid.Column="1"
                                                Content="Browse"
                                                Click="BrowseStickerButton_OnClick"
                                                Style="{StaticResource EditorSecondaryButtonStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Action & Behavior -->
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource InspectorCardStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAction}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="ACTION" Foreground="{StaticResource SecondaryText}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock Text="Action Type" Style="{StaticResource InspectorLabelStyle}"/>
                                    <TextBox AutomationProperties.Name="Action type" Text="{Binding ActionType, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EditorTextBoxStyle}"/>
                                    <TextBlock Text="Action Value" Style="{StaticResource InspectorLabelStyle}"/>
                                    <TextBox AutomationProperties.Name="Action value" Text="{Binding ActionValue, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EditorTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <!-- Text/emoji payload inserted into the foreground application. -->
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource InspectorCardStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasInputContent}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="INPUT CONTENT" Foreground="{StaticResource SecondaryText}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox AutomationProperties.Name="Text to insert" Text="{Binding InputContent, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="64"
                                             Style="{StaticResource EditorTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 5: Parameters (Provider / Slider Settings) -->
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource InspectorCardStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasProvider}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasExpandableSliderSettings}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="PARAMETERS" Foreground="{StaticResource SecondaryText}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,6"/>

                                    <!-- Provider ID -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasProvider}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Provider ID" Style="{StaticResource InspectorLabelStyle}"/>
                                        <TextBox AutomationProperties.Name="Widget provider" Text="{Binding Provider, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextBoxStyle}"/>
                                    </StackPanel>

                                    <!-- Slider Settings -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasExpandableSliderSettings}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Value" Style="{StaticResource InspectorLabelStyle}"/>
                                        <TextBox AutomationProperties.Name="Slider value" Text="{Binding SliderValue, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextBoxStyle}"/>
                                        <TextBlock Text="Minimum" Style="{StaticResource InspectorLabelStyle}"/>
                                        <TextBox AutomationProperties.Name="Slider minimum" Text="{Binding SliderMinimum, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextBoxStyle}"/>
                                        <TextBlock Text="Maximum" Style="{StaticResource InspectorLabelStyle}"/>
                                        <TextBox AutomationProperties.Name="Slider maximum" Text="{Binding SliderMaximum, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextBoxStyle}"/>
                                        <CheckBox AutomationProperties.Name="Enable slider" Content="Enabled"
                                                  IsChecked="{Binding SliderEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card 6: Widget Actions -->
                            <Border Style="{StaticResource InspectorCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="&#xE945;" Style="{StaticResource InspectorSectionIcon}"/><TextBlock Text="Actions" Foreground="{StaticResource PrimaryText}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/></StackPanel>
                                    <TextBlock Text="Reorder or remove this widget" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="34,0,0,16" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button AutomationProperties.Name="Move widget left" Grid.Column="0"
                                                Tag="Move Left" MinHeight="66"
                                                ToolTip="Move widget left"
                                                Command="{Binding DataContext.MoveSelectedWidgetLeftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource EditorSecondaryButtonStyle}"
                                                Margin="0,0,4,0"><StackPanel><TextBlock Text="&#xE76B;" Style="{StaticResource StudioIcon}"/><TextBlock Text="Move Left" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                                        <Button AutomationProperties.Name="Move widget right" Grid.Column="1"
                                                Tag="Move Right" MinHeight="66"
                                                ToolTip="Move widget right"
                                                Command="{Binding DataContext.MoveSelectedWidgetRightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource EditorSecondaryButtonStyle}"
                                                Margin="0,0,4,0"><StackPanel><TextBlock Text="&#xE76C;" Style="{StaticResource StudioIcon}"/><TextBlock Text="Move Right" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                                        <Button AutomationProperties.Name="Delete selected widget" Grid.Column="2"
                                                Tag="Delete" MinHeight="66"
                                                ToolTip="Delete selected widget"
                                                Command="{Binding DataContext.DeleteSelectedWidgetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource EditorDestructiveButtonStyle}"><StackPanel><TextBlock Text="&#xE74D;" Style="{StaticResource StudioIcon}"/><TextBlock Text="Delete" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- No Widget Selected: Profile & Page Inspector Cards -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedWidgetEditor}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Document}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Profile Settings Card -->
                            <Border Style="{StaticResource InspectorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="PROFILE" Foreground="{StaticResource EditorAccentText}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                    <TextBlock Text="ID" Style="{StaticResource InspectorLabelStyle}"/>
                                    <TextBlock Text="{Binding ProfileId}" Foreground="{StaticResource SecondaryText}" FontSize="11" FontFamily="Consolas, Segoe UI"/>
                                    <TextBlock Text="Display Name" Style="{StaticResource InspectorLabelStyle}"/>
                                    <TextBox AutomationProperties.Name="Profile name" Text="{Binding ProfileDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EditorTextBoxStyle}"/>
                                    <TextBlock Text="Schema Version" Style="{StaticResource InspectorLabelStyle}"/>
                                    <TextBlock Text="{Binding SchemaVersion}" Foreground="{StaticResource PrimaryText}" FontSize="11.5"/>
                                    <TextBlock Text="Match Rules" Style="{StaticResource InspectorLabelStyle}"/>
                                    <TextBlock Text="{Binding MatchSummary}"
                                               Foreground="{StaticResource SecondaryText}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <Button Content="Customize Appearance →"
                                            Command="{Binding DataContext.OpenAppearanceTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource EditorSecondaryButtonStyle}"
                                            Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Page Settings Card -->
                            <Border Style="{StaticResource InspectorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="CURRENT PAGE" Foreground="{StaticResource EditorAccentText}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                    <TextBlock Text="Page ID" Style="{StaticResource InspectorLabelStyle}"/>
                                    <TextBlock Text="{Binding CurrentPageIdentity}" Foreground="{StaticResource SecondaryText}" FontSize="11" FontFamily="Consolas, Segoe UI"/>
                                    <TextBlock Text="Page Name" Style="{StaticResource InspectorLabelStyle}"/>
                                    <TextBox x:Name="PageNameEditor" AutomationProperties.Name="Page name" Text="{Binding PageDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EditorTextBoxStyle}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <!-- Tab 2: Appearance Editor -->
        <TabItem AutomationProperties.Name="Appearance" DataContext="{Binding AppearanceEditor}"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Appearance" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
            <ScrollViewer PanningMode="VerticalFirst" VerticalScrollBarVisibility="Auto">
                <Grid Margin="14,12,14,18">
                    <StackPanel>
                        <!-- Header & Reset button -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabelStyle}" Margin="0" VerticalAlignment="Center"/>
                            <Button AutomationProperties.Name="Reset appearance to theme defaults" Grid.Column="1"
                                    Content="↺ Reset All"
                                    ToolTip="Reset appearance to theme defaults"
                                    Command="{Binding ResetAppearanceCommand}"
                                    Style="{StaticResource EditorSecondaryButtonStyle}"
                                    Padding="8,3"/>
                        </Grid>

                        <Border Style="{StaticResource InspectorCardStyle}"
                                DataContext="{Binding DataContext.ThemeLibrary, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel>
                                <TextBlock Text="MY THEMES" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                                <StackPanel IsEnabled="{Binding IsAvailable}">
                                    <TextBlock Text="Theme name" Style="{StaticResource InspectorLabelStyle}"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ThemeName, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="80" MinHeight="40" VerticalContentAlignment="Center"
                                                 AutomationProperties.Name="Theme name"
                                                 Style="{StaticResource EditorTextBoxStyle}" Margin="0,0,6,0"/>
                                        <Button AutomationProperties.Name="Save the current bar preview, colors and background media as a new theme" Grid.Column="1" Content="Save Copy" MinHeight="40"
                                                ToolTip="Save the current bar preview, colors and background media as a new theme"
                                                Click="SaveLibraryThemeButton_OnClick"
                                                Style="{StaticResource EditorPrimaryButtonStyle}" Padding="10,4"/>
                                    </Grid>
                                    <ScrollViewer PanningMode="VerticalFirst" MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Themes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:ThemeLibraryItem}">
                                                    <Grid Margin="0,0,0,6">
                                                        <Button Click="ApplyLibraryThemeButton_OnClick"
                                                                ToolTip="{Binding Name, StringFormat='Apply {0}'}"
                                                                AutomationProperties.Name="{Binding Name, StringFormat='Apply theme {0}'}"
                                                                MinHeight="92" Background="{StaticResource EditorInput}"
                                                                BorderBrush="{StaticResource EditorBorder}" Cursor="Hand">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                                            CornerRadius="6" Padding="8">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsPressed" Value="True">
                                                                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource EditorSelection}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <StackPanel>
                                                                <Image Source="{Binding Preview}" Height="32" Stretch="Uniform" Margin="0,0,0,10"/>
                                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryText}"
                                                                           FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,64,0"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Content="Export…" Click="ExportLibraryThemeButton_OnClick"
                                                                AutomationProperties.Name="{Binding Name, StringFormat='Export theme {0}'}"
                                                                ToolTip="Export this saved theme with its background image, GIF or video"
                                                                Style="{StaticResource EditorSecondaryButtonStyle}" FontSize="10" Padding="6,2"
                                                                MinHeight="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,4"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Button AutomationProperties.Name="Add a theme package with its preview and background media" Content="Import Theme Package…" Click="ImportLibraryThemeButton_OnClick"
                                            ToolTip="Add a theme package with its preview and background media"
                                            Style="{StaticResource EditorSecondaryButtonStyle}"
                                            Foreground="{StaticResource PrimaryText}" MinHeight="40" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource SecondaryText}"
                                           TextWrapping="Wrap" FontSize="10" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Expander Header="Theme JSON (settings only)" Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,0,0,12">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button AutomationProperties.Name="Save colors, preset, effects and background media settings" Content="Save JSON…"
                                    Click="SaveThemeButton_OnClick"
                                    ToolTip="Save colors, preset, effects and background media settings"
                                    Style="{StaticResource EditorSecondaryButtonStyle}"
                                    Foreground="{StaticResource PrimaryText}"
                                    MinHeight="40" Margin="0,0,4,0"/>
                            <Button AutomationProperties.Name="Apply a saved custom theme" Grid.Column="1" Content="Load JSON…"
                                    Click="LoadThemeButton_OnClick"
                                    ToolTip="Apply a saved custom theme"
                                    Style="{StaticResource EditorSecondaryButtonStyle}"
                                    Foreground="{StaticResource PrimaryText}"
                                    MinHeight="40" Margin="4,0,0,0"/>
                        </Grid>
                        </Expander>

                        <!-- Card 1: Preset Gallery -->
                        <Border Style="{StaticResource InspectorCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PRESET GALLERY" Foreground="{StaticResource SecondaryText}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button AutomationProperties.Name="Reset preset to Fluid defaults" Grid.Column="1"
                                            Content="↺"
                                            ToolTip="Reset preset, theme colors, and background media to defaults"
                                            Command="{Binding ResetPresetCommand}"
                                            Style="{StaticResource EditorSecondaryButtonStyle}"
                                            Padding="6,1"/>
                                </Grid>

                                <!-- Selectable Preset Cards List -->
                                <ItemsControl ItemsSource="{Binding Presets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:PresetCardViewModel}">
                                            <Button Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Id}"
                                                    Margin="0,0,0,6"
                                                    Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="CardBorder"
                                                                Background="{Binding CardBackground}"
                                                                BorderThickness="1.5"
                                                                BorderBrush="{StaticResource EditorBorder}"
                                                                CornerRadius="{Binding CardCornerRadius}"
                                                                Padding="10,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Left Color Dots Preview -->
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                    <Border Width="12" Height="12" CornerRadius="{Binding CardCornerRadius}" Background="{Binding PrimaryDotBrush}" Margin="0,0,4,0"/>
                                                                    <Border Width="12" Height="12" CornerRadius="{Binding CardCornerRadius}" Background="{Binding SecondaryDotBrush}"/>
                                                                </StackPanel>

                                                                <!-- Text Info -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               Foreground="{StaticResource PrimaryText}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="12"/>
                                                                    <TextBlock Text="{Binding Description}"
                                                                               Foreground="{StaticResource SecondaryText}"
                                                                               FontSize="10"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,2,0,0"/>
                                                                </StackPanel>

                                                                <!-- Right: Selection Indicator Badge -->
                                                                <Border x:Name="SelectBadge"
                                                                        Grid.Column="2"
                                                                        Width="18" Height="18"
                                                                        CornerRadius="9"
                                                                        Background="Transparent"
                                                                        BorderBrush="{StaticResource EditorBorder}"
                                                                        BorderThickness="1"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock x:Name="CheckMark"
                                                                               Text="✓"
                                                                               FontSize="11"
                                                                               FontWeight="Bold"
                                                                               Foreground="{StaticResource EditorAccentText}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Visibility="Collapsed"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                                                <Setter TargetName="SelectBadge" Property="Background" Value="{StaticResource AccentSubtle}"/>
                                                                <Setter TargetName="SelectBadge" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource PrimaryText}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Primary Accent -->
                        <Border Style="{StaticResource InspectorCardStyle}">
                            <ContentControl Content="{Binding AccentEditor}"/>
                        </Border>

                        <!-- Card 3: Secondary Accent -->
                        <Border Style="{StaticResource InspectorCardStyle}">
                            <ContentControl Content="{Binding SecondaryAccentEditor}"/>
                        </Border>

                        <!-- Card 4: Palette (Surfaces & Text) -->
                        <Border Style="{StaticResource InspectorCardStyle}">
                            <StackPanel>
                                <TextBlock Text="PALETTE (SURFACES &amp; TEXT)" Foreground="{StaticResource SecondaryText}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ContentControl Content="{Binding BackgroundEditor}" Margin="0,0,0,10"/>
                                <ContentControl Content="{Binding SurfaceEditor}" Margin="0,0,0,10"/>
                                <ContentControl Content="{Binding PrimaryTextEditor}" Margin="0,0,0,10"/>
                                <ContentControl Content="{Binding SecondaryTextEditor}"/>
                            </StackPanel>
                        </Border>

                        <!-- Full-bar background media -->
                        <Border Style="{StaticResource InspectorCardStyle}">
                            <StackPanel>
                                <ToggleButton AutomationProperties.Name="Show background-media overflow and framing guides" x:Name="BackgroundMediaEditToggle"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="0"
                                              Margin="-4,-3,-4,8"
                                              Cursor="Hand"
                                              FocusVisualStyle="{x:Null}"
                                              ToolTip="Show background-media overflow and framing guides">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="BackgroundMediaHeader" BorderThickness="1" BorderBrush="Transparent"
                                                    Background="Transparent"
                                                    CornerRadius="6"
                                                    Padding="4,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="BAR BACKGROUND MEDIA"
                                                               Foreground="{StaticResource SecondaryText}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="EDIT FRAME"
                                                               Foreground="{StaticResource TextMuted}"
                                                               FontSize="9.5"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BackgroundMediaHeader" Property="Background" Value="#14FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="BackgroundMediaHeader" Property="Background" Value="{StaticResource AccentSubtle}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="BackgroundMediaHeader" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox AutomationProperties.Name="Bar background media source" Text="{Binding BackgroundMediaSource, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="PNG, JPG, GIF or MP4"
                                             Style="{StaticResource EditorTextBoxStyle}"/>
                                    <Button IsEnabled="{Binding DataContext.IsMediaImportAvailable, RelativeSource={RelativeSource AncestorType=Window}}" Grid.Column="1"
                                            Content="Browse"
                                            Click="BrowseBackgroundMediaButton_OnClick"
                                            Style="{StaticResource EditorSecondaryButtonStyle}"
                                            Margin="6,0,0,0"
                                            Padding="7,3"/>
                                    <Button Grid.Column="2"
                                            Content="Clear"
                                            Command="{Binding ClearBackgroundMediaCommand}"
                                            Style="{StaticResource EditorSecondaryButtonStyle}"
                                            Margin="4,0,0,0"
                                            Padding="7,3"/>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox AutomationProperties.Name="Background media fit" SelectedValue="{Binding BackgroundMediaFit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Tag"
                                              Style="{StaticResource EditorComboBoxStyle}"
                                              MinWidth="100">
                                        <ComboBoxItem Content="Cover" Tag="cover"/>
                                        <ComboBoxItem Content="Contain" Tag="contain"/>
                                        <ComboBoxItem Content="Fill" Tag="fill"/>
                                    </ComboBox>
                                    <CheckBox AutomationProperties.Name="Enable background media" Grid.Column="1"
                                              Content="Enabled"
                                              IsChecked="{Binding BackgroundMediaEnabled, Mode=TwoWay}"
                                              Foreground="{StaticResource PrimaryText}"
                                              VerticalAlignment="Center"
                                              Margin="10,0,0,0"/>
                                    <CheckBox AutomationProperties.Name="Loop background media" Grid.Column="2"
                                              Content="Loop"
                                              IsChecked="{Binding BackgroundMediaLoop, Mode=TwoWay}"
                                              Foreground="{StaticResource PrimaryText}"
                                              VerticalAlignment="Center"
                                              Margin="10,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,10,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="OPACITY" Foreground="{StaticResource SecondaryText}" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BackgroundMediaOpacityPercent, StringFormat='{}{0}%'}" Foreground="{StaticResource PrimaryText}" FontSize="10"/>
                                </Grid>
                                <Slider AutomationProperties.Name="Background opacity" Minimum="0" Maximum="1" TickFrequency="0.05"
                                        Value="{Binding BackgroundMediaOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <Grid Margin="0,8,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ZOOM" Foreground="{StaticResource SecondaryText}" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BackgroundMediaZoomPercent, StringFormat='{}{0}%'}" Foreground="{StaticResource PrimaryText}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button AutomationProperties.Name="Reset zoom to 100%" Grid.Column="2"
                                            Content="↺"
                                            ToolTip="Reset zoom to 100%"
                                            Command="{Binding ResetBackgroundMediaZoomCommand}"
                                            Style="{StaticResource EditorSecondaryButtonStyle}"
                                            Padding="6,1"/>
                                </Grid>
                                <Slider AutomationProperties.Name="Background zoom" Minimum="0.1" Maximum="4" TickFrequency="0.05"
                                        Value="{Binding BackgroundMediaZoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <Grid Margin="0,8,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="HORIZONTAL POSITION" Foreground="{StaticResource SecondaryText}" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BackgroundMediaOffsetX, StringFormat='{}{0:F0} px'}" Foreground="{StaticResource PrimaryText}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button AutomationProperties.Name="Reset horizontal position" Grid.Column="2"
                                            Content="↺"
                                            ToolTip="Reset horizontal position"
                                            Command="{Binding ResetBackgroundMediaHorizontalCommand}"
                                            Style="{StaticResource EditorSecondaryButtonStyle}"
                                            Padding="6,1"/>
                                </Grid>
                                <Slider AutomationProperties.Name="Background horizontal position" Minimum="-1280" Maximum="1280" TickFrequency="1"
                                        Value="{Binding BackgroundMediaOffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <Grid Margin="0,8,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="VERTICAL POSITION" Foreground="{StaticResource SecondaryText}" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BackgroundMediaOffsetY, StringFormat='{}{0:F0} px'}" Foreground="{StaticResource PrimaryText}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button AutomationProperties.Name="Reset vertical position" Grid.Column="2"
                                            Content="↺"
                                            ToolTip="Reset vertical position"
                                            Command="{Binding ResetBackgroundMediaVerticalCommand}"
                                            Style="{StaticResource EditorSecondaryButtonStyle}"
                                            Padding="6,1"/>
                                </Grid>
                                <Slider AutomationProperties.Name="Background vertical position" Minimum="-72" Maximum="72" TickFrequency="1"
                                        Value="{Binding BackgroundMediaOffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 5: Intensity & Motion -->
                        <Border Style="{StaticResource InspectorCardStyle}">
                            <StackPanel>
                                <!-- Intensity Header -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="INTENSITY" Foreground="{StaticResource SecondaryText}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding IntensityPercent, StringFormat='{}{0}%'}"
                                               Foreground="{StaticResource PrimaryText}"
                                               FontFamily="Consolas, Segoe UI"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Button AutomationProperties.Name="Reset intensity to 100%" Grid.Column="2"
                                            Content="↺"
                                            ToolTip="Reset intensity to 100%"
                                            Command="{Binding ResetIntensityCommand}"
                                            Style="{StaticResource EditorSecondaryButtonStyle}"
                                            Padding="6,1"/>
                                </Grid>
                                <Slider AutomationProperties.Name="Appearance intensity" Minimum="0"
                                        Maximum="1"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="False"
                                        Value="{Binding Intensity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,4,0,12"/>

                                <Rectangle Height="1" Fill="{StaticResource EditorBorder}" Margin="0,0,0,12"/>

                                <!-- Motion Toggle -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="MOTION" Foreground="{StaticResource SecondaryText}" FontSize="10.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Subtle animations &amp; reactive glow" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                    </StackPanel>
                                    <CheckBox AutomationProperties.Name="Enable appearance motion" Grid.Column="1"
                                              Content="{Binding MotionLabel}"
                                              IsChecked="{Binding MotionEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Foreground="{StaticResource PrimaryText}"
                                              FontSize="11"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>
                                    <Button AutomationProperties.Name="Reset motion to default (On)" Grid.Column="2"
                                            Content="↺"
                                            ToolTip="Reset motion to default (On)"
                                            Command="{Binding ResetMotionCommand}"
                                            Style="{StaticResource EditorSecondaryButtonStyle}"
                                            Padding="6,1"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Border>

        <!-- ============================================================ -->
        <!--  5. Bottom: Collapsible Validation Drawer                    -->
        <!-- ============================================================ -->
        <Border Grid.Row="2" Grid.ColumnSpan="3"
                Background="{StaticResource EditorMaterial}"
                BorderBrush="{StaticResource EditorBorder}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Compact Validation Bar Toggle Header -->
                <Button Grid.Row="0"
                        AutomationProperties.Name="Toggle validation details"
                        Command="{Binding ToggleValidationCommand}"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="22,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Validation label & summary badge -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="13" Margin="0,0,12,0">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FF24845E"/><Style.Triggers><DataTrigger Binding="{Binding HasWarnings}" Value="True"><Setter Property="Background" Value="#FF65501F"/></DataTrigger><DataTrigger Binding="{Binding HasErrors}" Value="True"><Setter Property="Background" Value="#FF763C43"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE73E;"/><Style.Triggers><DataTrigger Binding="{Binding HasWarnings}" Value="True"><Setter Property="Text" Value="&#xE7BA;"/></DataTrigger><DataTrigger Binding="{Binding HasErrors}" Value="True"><Setter Property="Text" Value="&#xE783;"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        </Border>
                                        <TextBlock Text="Validation"
                                                   Foreground="{StaticResource PrimaryText}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Border Margin="10,0,0,0" CornerRadius="8" Padding="7,2" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                                            <Setter Property="Background" Value="#35FFB020"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                            <Setter Property="Background" Value="#35FF5C5C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ValidationSummary}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource StatusSuccess}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource StatusWarning}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource EditorErrorText}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- Middle: Status message -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding StatusMessage}"
                                               Foreground="{StaticResource SecondaryText}"
                                               FontSize="13"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="24,0,16,0"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Right: Expand / collapse chevron button -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE9D9;" Style="{StaticResource StudioIcon}" Foreground="{StaticResource TextMuted}" Margin="0,0,10,0"/>
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Diagnostics"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsValidationExpanded}" Value="True">
                                                            <Setter Property="Text" Value="Hide diagnostics"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE70E;"/><Style.Triggers><DataTrigger Binding="{Binding IsValidationExpanded}" Value="True"><Setter Property="Text" Value="&#xE70D;"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Expanded Diagnostics List Drawer (140px scrollable area when visible) -->
                <Border Grid.Row="1"
                        Height="140"
                        BorderBrush="{StaticResource EditorBorder}"
                        BorderThickness="0,1,0,0"
                        Visibility="{Binding IsValidationExpanded, Converter={StaticResource BoolToVis}}">
                    <ListBox x:Name="DiagnosticsList"
                             ItemsSource="{Binding Diagnostics}"
                             MouseDoubleClick="DiagnosticsList_OnMouseDoubleClick"
                             KeyDown="DiagnosticsList_OnKeyDown" AutomationProperties.Name="Validation issues"
                             Style="{StaticResource EditorListBoxStyle}"
                             ItemContainerStyle="{StaticResource EditorListItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2" ToolTip="{Binding Message}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Severity"
                                               Text="{Binding Severity}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource EditorWarning}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Code}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}"
                                               Foreground="{StaticResource PrimaryText}"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3"
                                               FontSize="13"
                                               Foreground="{StaticResource TextMuted}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="page {0}  •  widget {1}">
                                                <Binding Path="PageId"/>
                                                <Binding Path="WidgetId"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <Button Grid.Column="4" Click="DiagnosticGo_OnClick" Style="{StaticResource StudioIconButton}" ToolTip="Go to issue" AutomationProperties.Name="Go to issue"><TextBlock Text="&#xE76C;" Style="{StaticResource StudioIcon}"/></Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                        <Setter TargetName="Severity" Property="Foreground" Value="{StaticResource EditorErrorText}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
