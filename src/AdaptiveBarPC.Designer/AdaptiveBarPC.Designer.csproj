<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\AdaptiveBarPC.App\Resources\Brand\AdaptiveBar.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AdaptiveBarPC.Designer</AssemblyName>
    <RootNamespace>AdaptiveBarPC.Designer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdaptiveBarPC.App\AdaptiveBarPC.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AdaptiveBarPC.Tests" />
  </ItemGroup>
</Project>
