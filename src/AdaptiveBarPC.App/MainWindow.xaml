<Window x:Class="AdaptiveBarPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AdaptiveBarPC.ViewModels"
        xmlns:controls="clr-namespace:AdaptiveBarPC.Controls"
        Title="AdaptiveBarPC"
        Icon="/AdaptiveBarPC;component/Resources/Brand/AdaptiveBar.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Height="72">

    <!--
        Widget DataTemplates (ButtonItemViewModel, SliderItemViewModel, SpacerItemViewModel, etc.)
        are defined in Resources/BarControls.xaml and merged via App.xaml.
        Add new widget templates to BarControls.xaml, not here.
    -->

    <Border x:Name="RootBorder"
            Background="{Binding BarBackgroundBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource ShellCornerRadius}"
            Padding="0"
            ClipToBounds="True"
            SnapsToDevicePixels="True"
            IsManipulationEnabled="True"
            ManipulationStarting="RootBorder_OnManipulationStarting"
            ManipulationDelta="RootBorder_OnManipulationDelta"
            ManipulationInertiaStarting="RootBorder_OnManipulationInertiaStarting"
            ManipulationCompleted="RootBorder_OnManipulationCompleted">
        <Grid>
            <controls:DecorativeMediaView Source="{Binding BackgroundMediaSource}"
                                          Fit="{Binding BackgroundMediaFit}"
                                          Loop="{Binding BackgroundMediaLoop}"
                                          MediaEnabled="{Binding BackgroundMediaEnabled}"
                                          MediaOpacity="{Binding BackgroundMediaOpacity}"
                                          HorizontalOffset="{Binding BackgroundMediaOffsetX}"
                                          VerticalOffset="{Binding BackgroundMediaOffsetY}"
                                          Zoom="{Binding BackgroundMediaZoom}"
                                          MotionEnabled="{Binding BackgroundMediaMotionEnabled}"/>

            <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="8,7"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmojiPickerOpen}" Value="True">
                            <Setter Property="Margin" Value="8,2"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left context cluster: Profile & Page info + Vector Page Indicators -->
            <Grid Grid.Column="0"
                  Margin="2,0,6,0"
                  VerticalAlignment="Center"
                  MaxWidth="140"
                  IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="2,0">
                    <TextBlock Text="{Binding ActiveProfileName}"
                               Foreground="{Binding PrimaryTextBrush}"
                               FontFamily="{DynamicResource BarFontFamily}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding CurrentPageName}"
                                   Foreground="{Binding SecondaryTextBrush}"
                                   FontFamily="{DynamicResource BarFontFamily}"
                                   FontSize="10.5"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="76"
                                   VerticalAlignment="Center"/>

                        <!-- Vector Page Indicator Dots -->
                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding PageDots}"
                                      Margin="6,0,0,0"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      IsTabStop="False"
                                      Visibility="{Binding HasMultiplePages, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Dot"
                                            Width="4"
                                            Height="4"
                                            CornerRadius="2"
                                            Margin="1.5,0"
                                            Background="{DynamicResource TextMuted}"
                                            Opacity="0.4"
                                            SnapsToDevicePixels="True"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="Dot" Property="Background" Value="{DynamicResource AccentPrimary}"/>
                                            <Setter TargetName="Dot" Property="Opacity" Value="1.0"/>
                                            <Setter TargetName="Dot" Property="Width" Value="10"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>

                <!-- Subtle vertical divider separating context from widgets -->
                <Rectangle Grid.Column="1"
                           Width="1"
                           Height="22"
                           Fill="{DynamicResource Divider}"
                           Margin="8,0,2,0"
                           VerticalAlignment="Center"
                           SnapsToDevicePixels="True"/>
            </Grid>

            <ItemsControl Grid.Column="1"
                          ItemsSource="{Binding FixedLeftItems}"
                          Focusable="False"
                          IsTabStop="False"
                          Visibility="{Binding HasFixedLeftItems, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Centre: scrollable widget strip; swipe gesture handled in code-behind; subtle edge fade mask applied on overflow -->
            <ScrollViewer x:Name="ItemsScroller"
                          Grid.Column="2"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          PanningMode="None"
                          CanContentScroll="False">
                <ItemsControl x:Name="ItemsHost" ItemsSource="{Binding Items}">
                    <ItemsControl.RenderTransform>
                        <TranslateTransform X="0"/>
                    </ItemsControl.RenderTransform>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AdaptiveBarStripPanel VerticalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- Right panel: System controls & Page navigation -->
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="4,0,2,0">

                <!-- Subtle vertical divider separating center dynamic area from right controls -->
                <Rectangle Width="1"
                           Height="22"
                           Fill="{DynamicResource Divider}"
                           Margin="2,0,6,0"
                           VerticalAlignment="Center"
                           SnapsToDevicePixels="True"
                           IsHitTestVisible="False"
                           Visibility="{Binding HasRightControls, Converter={StaticResource BoolToVisibility}}"/>

                <!-- System controls cluster -->
                <ItemsControl ItemsSource="{Binding FixedRightItems}"
                              Focusable="False"
                              IsTabStop="False"
                              Visibility="{Binding HasFixedRightItems, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Legacy page-scoped system controls cluster -->
                <ItemsControl ItemsSource="{Binding SystemItems}"
                              Focusable="False"
                              IsTabStop="False"
                              Visibility="{Binding HasSystemItems, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Compact page navigation buttons (visible only when HasMultiplePages) -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="2,0,0,0"
                            Visibility="{Binding HasMultiplePages, Converter={StaticResource BoolToVisibility}}">
                    <controls:LongPressButton Style="{StaticResource FlexNavButtonStyle}"
                                              Focusable="False"
                                              IsTabStop="False"
                                              Command="{Binding PreviousPageCommand}"
                                              ToolTip="Previous Page" AutomationProperties.Name="Previous page">
                        <TextBlock Style="{StaticResource ThemedIconFontStyle}"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource PixelGlyphConverter}">
                                    <Binding Source="&#xE76B;"/>
                                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </controls:LongPressButton>
                    <controls:LongPressButton Style="{StaticResource FlexNavButtonStyle}"
                                              Focusable="False"
                                              IsTabStop="False"
                                              Command="{Binding NextPageCommand}"
                                              ToolTip="Next Page" AutomationProperties.Name="Next page">
                        <TextBlock Style="{StaticResource ThemedIconFontStyle}"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource PixelGlyphConverter}">
                                    <Binding Source="&#xE76C;"/>
                                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </controls:LongPressButton>
                </StackPanel>
            </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
